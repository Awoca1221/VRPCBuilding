  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440 \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u0442
    \u043C\u043D\u043E\u0433\u043E \u0442\u0435\u043F\u043B\u0430 \u043F\u0440\u0438
    \u0441\u0432\u043E\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
    \u043E\u043D \u043D\u0435 \u043F\u0435\u0440\u0435\u0433\u0440\u0435\u0432\u0430\u043B\u0441\u044F
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C \u043A\u0443\u043B\u0435\u0440,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0440\u0430\u0441\u0441\u0435\u0438\u0442
    \u0442\u0435\u043F\u043B\u043E. \u0414\u043B\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
    \u0442\u0435\u043F\u043B\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438
    \u043C\u0435\u0436\u0434\u0443 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u043E\u043C
    \u0438 \u043A\u0443\u043B\u0435\u0440\u043E\u043C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442
    \u0442\u0435\u0440\u043C\u043E\u043F\u0430\u0441\u0442\u0443.\n\n\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
    \u043D\u0430\u043C\u0430\u0437\u0430\u0442\u044C \u0442\u0435\u0440\u043C\u043E\u043F\u0430\u0441\u0442\u0443
    \u043D\u0430 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440 \u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u043D\u0430 \u043D\u0435\u0433\u043E \u043A\u0443\u043B\u0435\u0440."
