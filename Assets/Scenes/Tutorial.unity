  m_text: "\u041F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438 \u043B\u0435\u0436\u0430\u0442
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u044E\u0449\u0438\u0435,
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0435 \u0434\u043B\u044F
    \u0441\u0431\u043E\u0440\u043A\u0438 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430.
    \u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u0438 \u0438\u0437\u0443\u0447\u0438\u0442\u0435
    \u043A\u0430\u0436\u0434\u044B\u0439 \u0438\u0437 \u043D\u0438\u0445.\n\n\u0427\u0442\u043E\u0431\u044B
    \u0441\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u043E\u0431\u044A\u0435\u043A\u0442,
    \u0437\u0430\u0436\u043C\u0438\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443
    \u0437\u0430\u0445\u0432\u0430\u0442\u0430 \u0432\u0431\u043B\u0438\u0437\u0438
    \u043D\u0435\u0433\u043E. \u041E\u0431\u044A\u0435\u043A\u0442 \u043C\u043E\u0436\u043D\u043E
    \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C,
    \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0432 \u0435\u0433\u043E \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u0441\u0444\u0435\u0440 \u043D\u0430 \u0432\u0430\u0448\u0435\u043C \u043F\u043E\u044F\u0441\u0435."
