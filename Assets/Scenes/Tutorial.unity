  m_text: "<color=#ADD8E6>\u041E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u0430\u044F
    \u043F\u0430\u043C\u044F\u0442\u044C</color> - \u0442\u0438\u043F \u043F\u0430\u043C\u044F\u0442\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u0434\u043B\u044F \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0434\u0430\u043D\u043D\u044B\u0445
    \u0438 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435
    \u0438\u0445 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F. \u041D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0430
    \u0434\u043B\u044F \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0443\u043F\u0430
