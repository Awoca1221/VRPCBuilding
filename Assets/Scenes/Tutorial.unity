  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041D\u0430 \u0432\u0430\u0448\u0435\u043C \u043F\u043E\u044F\u0441\u0435
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
    <color=#ADD8E6>\"\u0441\u043A\u0430\u043D\u0435\u0440\"</color>, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u0439
    \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
    \u043E\u0431 \u043E\u0431\u044A\u0435\u043A\u0442\u0435, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u043F\u043E\u0434\u0441\u0432\u0435\u0442\u0438\u0442\u044C \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0435
    \u043C\u0435\u0441\u0442\u0430 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
    \u044D\u0442\u043E\u0433\u043E \u043E\u0431\u044A\u0435\u043A\u0442\u0430. \u0414\u043B\u044F
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0441\u0445\u0432\u0430\u0442\u0438\u0442\u0435 \u0441\u043A\u0430\u043D\u0435\u0440,
    \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u043B\u0443\u0447 \u043D\u0430
    \u043E\u0431\u044A\u0435\u043A\u0442 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \u0442\u0440\u0438\u0433\u0433\u0435\u0440 \u0434\u043B\u044F \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438."
