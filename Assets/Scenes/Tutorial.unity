  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041D\u0435 \u0432\u0441\u0435 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430 \u0431\u0443\u0434\u0443\u0442
    \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u044C \u0434\u0440\u0443\u0433
    \u043A \u0434\u0440\u0443\u0433\u0443. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u0430\u044F \u043F\u0430\u043C\u044F\u0442\u044C
    (\u041E\u0417\u0423) \u0442\u0438\u043F\u0430 DDR3 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
    \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u044C \u043A \u043C\u0430\u0442\u0435\u0440\u0438\u043D\u0441\u043A\u043E\u0439
    \u043F\u043B\u0430\u0442\u0435 \u0441 DDR4.\n\u041D\u0430 \u0441\u0442\u043E\u043B\u0435
    \u043B\u0435\u0436\u0430\u0442 \u0431\u0435\u043B\u0430\u044F \u041E\u0417\u0423
    (DDR4) \u0438 \u0447\u0435\u0440\u043D\u0430\u044F (DDR3), \u043C\u0430\u0442\u0435\u0440\u0438\u043D\u0441\u043A\u0430\u044F
    \u043F\u043B\u0430\u0442\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
    \u0442\u043E\u043B\u044C\u043A\u043E DDR4. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
    \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0443\u044E
    \u041E\u0417\u0423."
