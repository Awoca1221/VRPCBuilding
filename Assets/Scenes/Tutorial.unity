  m_text: "<color=#ADD8E6>\u041F\u0440\u043E\u0446\u0435\u0441c\u043E\u0440</color>
    - \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0431\u0430\u0437\u043E\u0432\u043E\u0439
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043F\u0440\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0438
    \u0447\u0430\u0441\u0442\u043E\u0442\u044B \u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0439
    \u043F\u0430\u043C\u044F\u0442\u0438. \u0415\u0441\u043B\u0438 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440
    \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0435\u0442 \u043B\u0438\u043C\u0438\u0442
    TDP \u043A\u0443\u043B\u0435\u0440\u0430, \u0442\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u043F\u0435\u0440\u0435\u0433\u0440\u0435\u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u0430
    \u0438 \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C.\n\n<color=#ADD8E6>\u0412\u0438\u0434\u0435\u043E\u043A\u0430\u0440\u0442\u0430</color>
    - \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0431\u0430\u0437\u043E\u0432\u043E\u0439
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0437\u0430 \u0441\u0447\u0451\u0442 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
