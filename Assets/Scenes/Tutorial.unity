  m_text: "\u0411\u043B\u043E\u043A \u043F\u0438\u0442\u0430\u043D\u0438\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
    \u043A\u0430\u0431\u0435\u043B\u0438 \u0434\u043B\u044F \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F \u0432 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435
    \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B. \u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
    \u043A\u0430\u0431\u0435\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
    \u0442\u0430\u043A\u0436\u0435, \u043A\u0430\u043A \u0438 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
    \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430 \u0432 \u0440\u0430\u0437\u044C\u0451\u043C.\n\n\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
    \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043A\u0430\u0431\u0435\u043B\u044C
    \u043F\u0438\u0442\u0430\u043D\u0438\u044F \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u0430
    \u0432 \u043C\u0430\u0442\u0435\u0440\u0438\u043D\u0441\u043A\u0443\u044E \u043F\u043B\u0430\u0442\u0443
    \u0438 \u043A\u0430\u0431\u0435\u043B\u044C \u043F\u0438\u0442\u0430\u043D\u0438\u044F
    \u0432\u0438\u0434\u0435\u043E\u043A\u0430\u0440\u0442\u044B \u0432 \u0432\u0438\u0434\u0435\u043E\u043A\u0430\u0440\u0442\u0443."
