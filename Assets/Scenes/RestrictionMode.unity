--- !u!114 &250250995
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 250250993}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044E
    \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0441\u043E\u0431\u0440\u0430\u0442\u044C
    \u0440\u0430\u0431\u043E\u0447\u0438\u0439 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440
    \u0438\u0437 \u043A\u0430\u0442\u0430\u043B\u043E\u0433\u0430 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0443\u044E\u0449\u0438\u0445.
    \u0414\u043B\u044F \u0441\u0431\u043E\u0440\u043A\u0438 \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
    \u043E\u0434\u043D\u043E \u0438\u0437 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0439:\n<color=#ADD8E6>1.
    \u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C</color>
    - \u043E\u0431\u0449\u0430\u044F \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C
    \u0441\u0431\u043E\u0440\u043A\u0438 \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C
    \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0435
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0432 \u0440\u0435\u0436\u0438\u043C\u0435.\n<color=#ADD8E6>2.
    \u0426\u0435\u043D\u0430</color> - \u0446\u0435\u043D\u0430 \u0441\u0431\u043E\u0440\u043A\u0438
    \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u043C\u0435\u043D\u044C\u0448\u0435,
    \u0447\u0435\u043C \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
    \u0432 \u0440\u0435\u0436\u0438\u043C\u0435.\n\n\u0418\u0442\u043E\u0433\u043E\u0432\u0430\u044F
    \u0441\u0431\u043E\u0440\u043A\u0430 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0441\u0447\u0451\u0442\u043E\u043C \u043E\u0442 0 \u0434\u043E 1000. \u0427\u0435\u043C
    \u0431\u043B\u0438\u0436\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C/\u0446\u0435\u043D\u0430
    \u043A \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u043C\u0443 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044E
    - \u0442\u0435\u043C \u043B\u0443\u0447\u0448\u0435."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
